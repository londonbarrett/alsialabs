{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": {},
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "rm -rf *": "ask",
      "sudo *": "deny"
    },
    "edit": {
      "*": "allow",
      "drizzle/meta/*": "ask",
      "drizzle/*.sql": "ask"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  }
}
