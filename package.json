{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx lib/drizzle/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db:up": "docker compose up -d --wait",
    "test:db:down": "docker compose down",
    "test:db:migrate": "DB_DIRECT_URL=postgresql://alsia:alsia_test@localhost:55432/alsia_test pnpm db:migrate",
    "test:db:seed": "DATABASE_URL=postgresql://alsia:alsia_test@localhost:55432/alsia_test DATABASE_SSL=disable tsx lib/drizzle/seed-e2e.ts",
    "test:db:setup": "pnpm test:db:up && pnpm test:db:migrate && pnpm test:db:seed",
    "test:e2e": "pnpm test:db:setup && playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint --max-warnings=0 && pnpm test:run --coverage"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@base-ui/react": "^1.8.0",
    "@react-email/components": "^1.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.1",
    "next-safe-action": "^8.6.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "postgres": "^3.4.9",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.6.4",
    "recharts": "^3.8.0",
    "resend": "^6.14.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vitest-drizzle-mock": "^0.6.0"
  }
}
